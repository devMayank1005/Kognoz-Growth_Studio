# ---- Database (Neon / Lakebase Postgres) ----
# Pooled endpoint (has "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct endpoint (no "-pooler") — used by schema migrations, pg_dump, and
# anything needing session state. Neon's pooler does not support those.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Anthropic ----
# Server-side only. Never expose with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY="sk-ant-..."

# ---- Better Auth ----
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google SSO (optional until Phase 2 SSO)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Access ----
# Who gets a workspace on first sign-in. Comma-separated domains.
# Layered on top of MICROSOFT_TENANT_ID: the tenant lock excludes other Entra
# directories; this additionally excludes tenant GUESTS, who keep their own
# address. An empty value refuses to start rather than admitting everyone.
ALLOWED_EMAIL_DOMAINS="kognozconsulting.com"

# Entra tenant id. "common" (the default) accepts ANY Microsoft account —
# set this to lock sign-in to your directory.
MICROSOFT_TENANT_ID=""

# Microsoft SSO
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ---- Inngest (jobs) ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---- Zoho CRM (PRD §6) ----
# Register a SERVER-BASED APPLICATION at https://api-console.zoho.com — not a
# Self Client. A Self Client's grant token is bound to whichever Zoho account is
# signed in to the API Console, so it can never be re-authorised from Settings,
# and swapping to a service account later would mean handing over console access.
#
# Register the app under an account the ORGANISATION owns (a functional
# crm-integrations@ login held by the super-admin), never an individual's: if
# that account is closed, the client dies and every refresh token it ever issued
# dies with it.
#
# Register these redirect URIs exactly — Zoho matches them byte for byte:
#   https://kognoz-growthstudio.vercel.app/api/zoho/callback
#   http://localhost:3000/api/zoho/callback
#   http://localhost:3001/api/zoho/callback   <- dev often lands here
# Vercel PREVIEW deployments cannot connect Zoho: their URLs change per deploy.
ZOHO_CLIENT_ID=1000.MCBARZF92RY1HPZYBEU31OLK4CFAGC
ZOHO_CLIENT_SECRET=96b495b4a8c2ab06d19c79b252f1687ca6e992b150

# Refresh-token encryption at rest (PRD §11). AES-256-GCM.
#   openssl rand -base64 32
# Must decode to exactly 32 bytes. Read with readSecret — unlike
# BETTER_AUTH_SECRET, which is deliberately left raw, a wrong value here does
# not fail as a config error: it fails as a GCM auth-tag mismatch, which reads
# exactly like data corruption.
ZOHO_TOKEN_KEY=""

# Decrypt-only, during a key rotation. Remove once every row is re-encrypted.
ZOHO_TOKEN_KEY_PREVIOUS=""

# Where the authorize leg STARTS. Zoho is region-sharded and tokens are NOT
# portable across data centres, so the real values are whatever Zoho returns in
# `accounts-server` and `api_domain`; those are stored per connection and this
# is only the starting point.
#   US https://accounts.zoho.com        IN https://accounts.zoho.in
#   EU https://accounts.zoho.eu         AU https://accounts.zoho.com.au
#   SA https://accounts.zoho.sa         CA https://accounts.zohocloud.ca
# Note Canada is zohocloud.ca, NOT zoho.ca — which is why domains are stored as
# returned rather than derived from a region code.
ZOHO_ACCOUNTS_DOMAIN="https://accounts.zoho.com"
