# Copy to .env.test. Used in preference to .env.local by every test suite
# (tests/env.ts), so the integration and E2E tests cannot write to real data.
#
# Anything throwaway will do. Two options:
#
#   1. A local Postgres, which is free and offline:
#        createdb growth_test
#        DATABASE_URL=postgres://localhost:5432/growth_test pnpm db:migrate
#        DATABASE_URL=postgres://localhost:5432/growth_test pnpm db:seed
#
#   2. A Neon branch, if you want the pooler in the loop:
#        neon branches create --name test
#      then paste its connection strings below.
#
# Both connection strings are set because drizzle-kit and the E2E helpers use the
# unpooled one for DDL and session-scoped settings. Pointing both at the same
# local database is fine.
DATABASE_URL=postgres://localhost:5432/growth_test
DATABASE_URL_UNPOOLED=postgres://localhost:5432/growth_test

# Any 32+ character string. The E2E helper signs its own session cookie with this,
# so it only has to match what the app under test is running with.
BETTER_AUTH_SECRET=test-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001

# The allowlist is configuration, never a database row (src/domain/access.ts), and
# the app refuses to boot without it.
ALLOWED_EMAIL_DOMAINS=example.com

# The seed's workspace slug, which the E2E user is provisioned into.
DEFAULT_ORG_SLUG=kognoz-konverz

# src/lib/auth.ts throws at import without these, so the app will not start at
# all. Placeholders are fine: no test signs in through Microsoft — the E2E helper
# writes a session row and signs the cookie with BETTER_AUTH_SECRET.
MICROSOFT_CLIENT_ID=placeholder-client-id
MICROSOFT_CLIENT_SECRET=placeholder-client-secret
