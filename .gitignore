# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env — real secrets ignored, the template is tracked
.env*
!.env.example

# drizzle
drizzle/meta/_journal.json.bak

# test artefacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.neon

# Database dumps — contain real user email addresses (PRD §8).
# The README in this directory IS tracked; the dumps are not.
backups/*.dump
backups/*.sql

# playwright
/test-results/
/playwright-report/
